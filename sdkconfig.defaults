# FOC control ISR uses ADC continuous DMA and MCPWM callbacks while flash cache
# may be unavailable.
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y
CONFIG_MCPWM_ISR_CACHE_SAFE=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
# 20 kHz FOC ISR 在经典 ESP32 的 160 MHz 配置下实测会超过 50 us 周期，
# 使用芯片支持的 240 MHz，给浮点控制链留出周期余量。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Level-1 FPU ISR 与中断回溯共用 EXCSAVE1 时会破坏回溯帧。
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=n
CONFIG_FREERTOS_FPU_IN_ISR=y
CONFIG_FREERTOS_ISR_STACKSIZE=4096
